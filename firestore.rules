rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ─────────────────────────────────────────────────────────────

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == 'iva@brownworks4u2.com';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─── Public stats cache ───────────────────────────────────────────────────
    // Aggregate research stats — written ONLY by the trusted Cloud Function
    // (Admin SDK bypasses these rules entirely). Previously any signed-in
    // user could write here directly, which meant anyone could overwrite
    // the published numbers (audit finding M2).
    match /publicStats/{docId} {
      allow read:   if true;
      allow write:  if isAdmin();
    }

    // ─── User profiles & subcollections ──────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();

      match /flashes/{flashId} {
        allow read:   if isOwner(uid) || isAdmin();
        allow write:  if isOwner(uid);
      }

      match /timeCapsules/{capsuleId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /checkins/{checkinId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /checkinLog/{logId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      match /journalEntries/{entryId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }
    }

    // Raw flash records are NEVER readable across users, by anyone but the
    // owner or the admin (see /users/{uid}/flashes/{flashId} rule above).
    // Research aggregation is computed by a trusted Cloud Function using
    // Firebase Admin privileges (which bypass these rules entirely) and
    // writes only de-identified totals to /publicStats — never raw records.
    match /{path=**}/flashes/{flashId} {
      allow read, write: if isAdmin();
    }

    // ─── Partner messages ─────────────────────────────────────────────────────
    // Partners write a check-in; the account holder reads it in their home screen.
    match /partnerMessages/{msgId} {
      allow read:   if isAuthenticated()
                    && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ─── Newsletter / Ambassador newsletter ───────────────────────────────────
    match /newsletter/{docId} {
      allow read:          if isAdmin();
      allow create:        if isAuthenticated()
                           && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /ambassadorNewsletter/{docId} {
      allow read:          if isAdmin();
      allow create:        if isAuthenticated()
                           && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── Community posts ──────────────────────────────────────────────────────
    match /community/{postId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isAuthenticated()
                    && resource.data.userId == request.auth.uid)
                    || isAdmin();
    }

    // ─── Stories ──────────────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if (isAuthenticated()
                    && resource.data.userId == request.auth.uid)
                    || isAdmin();
    }

    // ─── Hot moments ──────────────────────────────────────────────────────────
    match /hotMoments/{docId} {
      allow read:   if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ─── User submissions (humor, encouragement, feedback) ───────────────────
    match /humorSubmissions/{docId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /encouragementSubmissions/{docId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /feedback/{docId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Same pattern as /feedback above — this collection existed in the app
    // code (FeedbackScreen.tsx) but had no matching rule, so writes were
    // silently failing permission checks for every non-admin user.
    match /user_feedback/{docId} {
      allow read:   if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // ─── Affiliate / referral program ──────────────────────────────────────
    // Doc id == the affiliate's referral code, with a `userId` field set at
    // creation identifying the owner. Three very different trust levels:
    //   - clicks: anyone can increment, even logged out — referral links
    //     are clicked before the visitor ever signs in
    //   - signups: written by the app when a real account is created via a
    //     referral code (see lib/referral.ts) — any signed-in write allowed
    //   - paypalEmail: ONLY the affiliate who owns this doc may set/change it
    //   - earningsPending: real money. Never client-writable. Only ever
    //     credited by a trusted Cloud Function once a referred user actually
    //     subscribes (not yet built — see Prompt Book Findings Log) or by
    //     the admin.
    match /affiliates/{code} {
      allow read: if isAdmin()
                  || (isAuthenticated()
                      && resource.data.userId == request.auth.uid);
      allow create: if isAuthenticated()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.earningsPending == 0
                    && request.resource.data.clicks == 0
                    && request.resource.data.signups == 0;
      allow update: if isAdmin()
                    || (
                      // Public referral links may increment a counter by one,
                      // but may never set an arbitrary value or touch money.
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['clicks'])
                      && request.resource.data.clicks == resource.data.clicks + 1
                    )
                    || (
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['signups'])
                      && request.resource.data.signups == resource.data.signups + 1
                    )
                    || (
                      // The owner may update only their own payout email.
                      isAuthenticated()
                      && resource.data.userId == request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['paypalEmail'])
                    );
      allow delete: if isAdmin();
    }

    // ─── Shop screen view tracking ─────────────────────────────────────────
    // One doc per user (docId == uid), same ownership pattern as /users/{uid}.
    // Existed in app code (ShopScreen.tsx) with no matching rule — writes
    // were silently failing permission checks for every non-admin user.
    match /shopViews/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // ─── Public profiles & username index ────────────────────────────────────
    match /profiles/{username} {
      allow read:   if true;
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /usernames/{username} {
      allow read:   if true;
      allow create: if isAuthenticated()
                    && request.resource.data.uid == request.auth.uid;
      allow delete: if isAuthenticated()
                    && resource.data.uid == request.auth.uid;
    }

    // ─── Beta Application Gating (Pioneer Beta) ──────────────────────────────
    // SECURITY FIX (H6 + H7): this used to allow direct client reads of the
    // token doc (exposing the applicant's email to anyone who had the
    // token string) and unrestricted application creation with no
    // server-side verification at all. Both are now handled entirely by
    // the submitBetaApplication Cloud Function, which uses the Admin SDK
    // and bypasses these rules — so the client no longer needs, or gets,
    // any direct access to either collection.
    match /betaApplicationTokens/{token} {
      allow read, write: if false;
    }

    match /betaApplications/{applicationId} {
      allow read, write: if false;
    }

    // ─── Waitlist ─────────────────────────────────────────────────────────────
    // Public signup form — anyone can join, only admin can see entries.
    match /waitlist/{docId} {
      allow read:   if isAdmin();
      allow create: if true;
    }

    // ─── Catch-all: deny everything not matched above ─────────────────────────
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}